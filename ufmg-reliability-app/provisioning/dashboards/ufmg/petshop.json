        "windowSeconds": 300,
        "countMode": "cumulative",
        "latencyMode": "p95",
        "failureMode": "error"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_server_request_duration_seconds_count{componente=\"$servico\"}) + 0 * ($tau_ms + $slo_erro + $slo_lat + $min_req)",
