    {
      "type": "ufmg-reliability-summary-panel",
      "id": 1,
      "title": "Só erro (meta: R_erro ≥ ${slo_erro:text} por janela)",
      "description": "Disponibilidade A = fração das janelas de 5 min com pelo menos 99% de requisições sem erro. MTBF = tempo médio dentro da meta entre dois episódios; MTTR = duração média de um episódio (janelas ruins seguidas).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
