      "interval": "5m",
      "options": {
        "sloErro": 0.99,
        "sloLat": 0.95,
        "minRequests": 100,
        "rowLabel": "componente",
        "countMode": "cumulative",
        "hideUnjudged": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (componente) (http_server_request_duration_seconds_count{principal=\"sim\"}) + 0 * ($tau_ms + $slo_erro + $slo_lat + $min_req)",
          "legendFormat": "{{componente}} total",
          "editorMode": "code",
          "range": true,
          "interval": "5m"
        },
        {
          "refId": "B",
          "expr": "sum by (componente) (http_server_request_duration_seconds_count{principal=\"sim\",error_type!=\"\"})",
          "legendFormat": "{{componente}} erros",
          "editorMode": "code",
          "range": true,
          "interval": "5m"
        }
      ]
    },
    {
      "type": "table",
      "id": 5,
      "title": "Confiabilidade por componente no período (R_erro = 1 − erros / requisições)",
      "description": "Os 10 componentes do caminho que atende o usuário, do menos para o mais confiável.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "sum by (componente) (max_over_time(http_server_request_duration_seconds_count{principal=\"sim\"}[$__range]) - min_over_time(http_server_request_duration_seconds_count{principal=\"sim\"}[$__range]))"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "sum by (componente) (max_over_time(http_server_request_duration_seconds_count{principal=\"sim\",error_type!=\"\"}[$__range]) - min_over_time(http_server_request_duration_seconds_count{principal=\"sim\",error_type!=\"\"}[$__range]))"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "1 - (sum by (componente) (max_over_time(http_server_request_duration_seconds_count{principal=\"sim\",error_type!=\"\"}[$__range]) - min_over_time(http_server_request_duration_seconds_count{principal=\"sim\",error_type!=\"\"}[$__range]))) / (sum by (componente) (max_over_time(http_server_request_duration_seconds_count{principal=\"sim\"}[$__range]) - min_over_time(http_server_request_duration_seconds_count{principal=\"sim\"}[$__range])))"
        }
