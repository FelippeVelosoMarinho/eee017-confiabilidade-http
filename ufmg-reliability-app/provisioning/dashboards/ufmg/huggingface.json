          "expr": "sum by (le) (http_server_request_duration_seconds_bucket{server_address=~\"$server_address\",http_route=~\"$http_route\"})",
          "legendFormat": "le={{le}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
