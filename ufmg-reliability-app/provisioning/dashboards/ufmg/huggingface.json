          "expr": "sum(http_server_request_duration_seconds_count{server_address=~\"$server_address\",http_route=~\"$http_route\",error_type!=\"\"})",
          "legendFormat": "erros acumulados",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
