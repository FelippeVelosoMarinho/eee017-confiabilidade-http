      "id": 5,
      "type": "timeseries",
      "title": "Requisições por janela e o mínimo",
      "description": "Volume de cada janela, pela diferença do contador acumulado. Abaixo da linha, a janela não é julgada.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
