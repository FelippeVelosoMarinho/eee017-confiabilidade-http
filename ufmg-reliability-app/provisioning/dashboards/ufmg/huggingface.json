      "maxDataPoints": 11000,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "(sum(http_server_request_duration_seconds_count{server_address=~\"$server_address\",http_route=~\"$http_route\"}) - sum(http_server_request_duration_seconds_count{server_address=~\"$server_address\",http_route=~\"$http_route\"} offset $window))",
