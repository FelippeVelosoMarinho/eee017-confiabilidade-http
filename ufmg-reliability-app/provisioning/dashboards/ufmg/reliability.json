      },
      {
        "name": "http_route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds}" },
        "label": "Rota",
        "query": "label_values(http_server_request_duration_seconds_count, http_route)",
        "refresh": 2,
        "regex": "",
